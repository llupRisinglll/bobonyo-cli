{
	"name": "bobonyo",
	"version": "0.4.10",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": ">=1.4.0"
	},
	"description": "A model-agnostic terminal coding harness with multi-agent collaboration",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/llupRisinglll/bobonyo-cli.git"
	},
	"homepage": "https://github.com/llupRisinglll/bobonyo-cli#readme",
	"bugs": {
		"url": "https://github.com/llupRisinglll/bobonyo-cli/issues"
	},
	"keywords": [
		"coding-agent",
		"terminal",
		"ai",
		"llm",
		"cli"
	],
	"files": [
		"src",
		"dist",
		"scripts/launcher.sh",
		"LICENSE",
		"README.md"
	],
	"bin": {
		"bobonyo": "dist/bobonyo"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun run src/index.tsx",
		"preview": "bun run src/index.tsx --preview tui",
		"build": "bun scripts/build.mjs",
		"format:check": "bash scripts/check-format.sh",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"prepare": "husky"
	},
	"dependencies": {
		"@opentui/core": "0.4.5",
		"@opentui/solid": "0.4.5",
		"solid-js": "^1.9.0"
	},
	"devDependencies": {
		"@tsconfig/bun": "^1.0.0",
		"@types/bun": "^1.2.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.6",
		"typescript": "^5.7.0"
	}
}
