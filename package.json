{
	"name": "bobonyo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Rewrite of the nanocoder CLI on Solid + OpenTUI (parity target: docs/business-logic/cli)",
	"scripts": {
		"dev": "bun run src/index.tsx",
		"preview": "bun run src/index.tsx --preview tui",
		"build": "bun scripts/build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"prepare": "husky"
	},
	"dependencies": {
		"@opentui/core": "0.4.5",
		"@opentui/solid": "0.4.5",
		"solid-js": "^1.9.0"
	},
	"devDependencies": {
		"@tsconfig/bun": "^1.0.0",
		"@types/bun": "^1.2.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.6",
		"typescript": "^5.7.0"
	}
}
